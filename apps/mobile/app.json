{
    "expo": {
        "name": "HabitFlow",
        "slug": "habitflow",
        "version": "1.6.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "habitflow",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "package": "com.habitflow",
            "adaptiveIcon": {
                "backgroundColor": "#FFF6E8",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "permissions": ["android.permission.RECORD_AUDIO"]
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "./plugins/withAndroidLegacyIcon",
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#FFF6E8",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 192,
                    "dark": {
                        "backgroundColor": "#181310",
                        "image": "./assets/images/splash-icon-dark.png"
                    }
                }
            ],
            "expo-secure-store",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow HabitFlow to access your photos so you can set a profile picture."
                }
            ],
            [
                "expo-notifications",
                {
                    "color": "#E87842"
                }
            ],
            "expo-audio",
            "expo-web-browser"
        ],
        "experiments": {
            "typedRoutes": false,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "1f4b7515-52a1-4516-8160-03c8fe69e825"
            }
        },
        "owner": "mehedi_cou_12"
    }
}
