# Production API on Render.
# For local dev from a device/emulator use your machine's LAN IP instead
# (e.g. http://192.168.1.5:4000) — localhost does not reach the dev machine.
EXPO_PUBLIC_API_URL=your-production-api-url-here

# Must match the API's APP_CLIENT_KEY so requests pass its client check.
EXPO_PUBLIC_APP_CLIENT_KEY=
