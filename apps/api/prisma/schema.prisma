generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AppPlatform {
  ANDROID
  IOS
}

model AppRelease {
  id        String      @id @default(cuid())
  platform  AppPlatform @unique
  // Newest published version, e.g. "1.2.0" — surfaces as a dismissible nudge.
  latest    String
  minimum   String
  // Where the Update button sends the user: a direct APK link or a store page.
  url       String
  notes     String?
  // Admin who last published, for the dashboard's audit line.
  updatedBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  password        String?
  googleId        String?        @unique
  avatarUrl       String?
  role            Role           @default(USER)
  // status          AccountStatus @default(PENDING)
  status          AccountStatus  @default(ACTIVE)
  statusChangedAt DateTime?
  statusChangedBy String?
  statusNote      String?
  tokenVersion    Int            @default(0)
  lastActiveAt    DateTime?
  lastAppVersion  String?
  /// Which client that version came from: "android", "ios" or "web".
  lastAppPlatform String?
  habits          Habit[]
  payments        Payment[]
  focusSessions   FocusSession[]
  dayNotes        DayNote[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}


model Payment {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail    String?
  amount       Int
  currency     String   @default("BDT")
  method       String   @default("CASH")
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Habit {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  goal          Int
  icon          String         @default("sprout")
  tod           String         @default("anytime")
  verb          String?
  target        Int?
  /// Unit label for `target`, e.g. "cups", "min", "pages". Null when binary.
  unit          String?
  /// How much one tap adds — 1 for cups, 10 for minutes.
  step          Int            @default(1)
  fillFromFocus Boolean        @default(false)
  // the migration needs no backfill.
  daysOfWeek    Int[]          @default([])
  archivedAt    DateTime?
  logs          HabitLog[]
  skips         HabitSkip[]
  focusSessions FocusSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, archivedAt])
}


model DayNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  day       Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One note per day, which makes the client's PUT idempotent.
  @@unique([userId, year, month, day])
  @@index([userId, year, month])
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  minutes   Int
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  @@index([userId, year, month, day])
}


model HabitSkip {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  // One skip per day, which makes the client's PUT idempotent.
  @@unique([habitId, year, month, day])
  @@index([userId, year, month])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  day       Int
  amount    Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([habitId, year, month, day])
}
