generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  password        String?
  googleId        String?       @unique
  avatarUrl       String?
  role            Role          @default(USER)
  status          AccountStatus @default(PENDING)
  statusChangedAt DateTime?
  statusChangedBy String?
  statusNote      String?
  // Bumped to revoke every outstanding token for this user at once (sign-out,
  // password change). Embedded in each JWT; JwtStrategy rejects a token whose
  // version no longer matches. See auth.service.ts / jwt.strategy.ts.
  tokenVersion    Int           @default(0)
  habits          Habit[]
  payments        Payment[]
  focusSessions   FocusSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  currency     String   @default("BDT")
  method       String   @default("CASH")
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Habit {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  goal          Int
  icon          String         @default("sprout")
  tod           String         @default("anytime")
  verb          String?
  logs          HabitLog[]
  focusSessions FocusSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// One completed focus (Pomodoro) session. The habit link survives as history
// even if the habit is later deleted (SetNull), so dedication stats never
// shrink retroactively. year/month/day are the CLIENT's local calendar day —
// same convention as HabitLog — so stats group by the user's day, not the
// server's timezone.
model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  minutes   Int
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  @@index([userId, year, month, day])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  @@unique([habitId, year, month, day])
}
