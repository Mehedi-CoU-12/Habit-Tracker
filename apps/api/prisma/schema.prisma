generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AppPlatform {
  ANDROID
  IOS
}

model AppRelease {
  id       String      @id @default(cuid())
  platform AppPlatform @unique
  // Newest published version, e.g. "1.2.0" — surfaces as a dismissible nudge.
  latest   String
  // Oldest version still supported. Anything below it gets a blocking prompt,
  // for when an old client would break against the current API.
  minimum  String
  // Where the Update button sends the user: a direct APK link or a store page.
  url      String
  notes    String?
  // Admin who last published, for the dashboard's audit line.
  updatedBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  password        String?
  googleId        String?       @unique
  avatarUrl       String?
  role            Role          @default(USER)
  // status          AccountStatus @default(PENDING)
  status          AccountStatus @default(ACTIVE)
  statusChangedAt DateTime?
  statusChangedBy String?
  statusNote      String?
  tokenVersion    Int           @default(0)
  habits          Habit[]
  payments        Payment[]
  focusSessions   FocusSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  currency     String   @default("BDT")
  method       String   @default("CASH")
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Habit {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  goal          Int
  icon          String         @default("sprout")
  tod           String         @default("anytime")
  verb          String?
  logs          HabitLog[]
  focusSessions FocusSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  minutes   Int
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  @@index([userId, year, month, day])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  @@unique([habitId, year, month, day])
}
