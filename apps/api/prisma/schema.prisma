generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AppPlatform {
  ANDROID
  IOS
}

model AppRelease {
  id        String      @id @default(cuid())
  platform  AppPlatform @unique
  // Newest published version, e.g. "1.2.0" — surfaces as a dismissible nudge.
  latest    String
  // Oldest version still supported. Anything below it gets a blocking prompt,
  // for when an old client would break against the current API.
  minimum   String
  // Where the Update button sends the user: a direct APK link or a store page.
  url       String
  notes     String?
  // Admin who last published, for the dashboard's audit line.
  updatedBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  password        String?
  googleId        String?        @unique
  avatarUrl       String?
  role            Role           @default(USER)
  // status          AccountStatus @default(PENDING)
  status          AccountStatus  @default(ACTIVE)
  statusChangedAt DateTime?
  statusChangedBy String?
  statusNote      String?
  tokenVersion    Int            @default(0)
  habits          Habit[]
  payments        Payment[]
  focusSessions   FocusSession[]
  dayNotes        DayNote[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  currency     String   @default("BDT")
  method       String   @default("CASH")
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Habit {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  goal          Int
  icon          String         @default("sprout")
  tod           String         @default("anytime")
  verb          String?
  /// Daily target amount, e.g. 8 (cups). Null is a binary done/not-done habit,
  /// which is every habit predating this column — so no backfill is needed.
  target        Int?
  /// Unit label for `target`, e.g. "cups", "min", "pages". Null when binary.
  unit          String?
  /// How much one tap adds — 1 for cups, 10 for minutes.
  step          Int            @default(1)
  // Weekdays the habit is expected on, 0 = Sunday. An empty list means every
  // day — which is exactly what every habit predating this column meant, so
  // the migration needs no backfill.
  daysOfWeek    Int[]          @default([])
  // Set when the user archives the habit. It leaves Today and the reminder
  // schedule but keeps every log, so past stats stay honest — unlike delete,
  // which cascades the history away.
  archivedAt    DateTime?
  logs          HabitLog[]
  focusSessions FocusSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, archivedAt])
}

/// One free-text reflection per calendar day, independent of any habit.
/// Day-scoped rather than log-scoped on purpose: the note that matters most is
/// usually "why did I miss this", and a missed day has no HabitLog row to
/// hang it on.
model DayNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  day       Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One note per day, which makes the client's PUT idempotent.
  @@unique([userId, year, month, day])
  @@index([userId, year, month])
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  minutes   Int
  year      Int
  month     Int
  day       Int
  createdAt DateTime @default(now())

  @@index([userId, year, month, day])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  year      Int
  month     Int
  day       Int
  /// How much was done that day. 1 is what every pre-existing row means, so the
  /// default reads them all as complete against a null target.
  amount    Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([habitId, year, month, day])
}
