PORT=
DATABASE_URL="postgresql://user:password@localhost:5432/habitflow?schema=public"
FRONTEND_URL="http://localhost:3000"
JWT_EXPIRE=5d
JWT_SECRET=

# Shared secret the web/mobile clients send as the `x-app-client` header so the
# API can reject non-app traffic (e.g. Postman). Must match
# NEXT_PUBLIC_APP_CLIENT_KEY (web) and EXPO_PUBLIC_APP_CLIENT_KEY (mobile).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to DISABLE the client check.
APP_CLIENT_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

SMTP_MAIL=
SMTP_PASSWORD=
SMTP_SERVICE=
STRIPE_API_KEY=
STRIPE_SECRET_KEY=

# Keep-alive self-ping (prevents Render free tier from sleeping).
# On Render this works automatically via RENDER_EXTERNAL_URL — no config needed.
# KEEP_ALIVE_URL overrides the base URL on other hosts; leave empty in dev.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=
