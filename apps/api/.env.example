PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/habitflow?schema=public"

# Redis cache (optional). Leave empty to run without caching — every read
# then goes straight to Postgres. Local: redis://localhost:6379. Hosted
# (Render Key Value, Upstash, ...): use the rediss:// URL they give you.
# A Redis outage never breaks the API; /health reports the connection state.
REDIS_URL=
FRONTEND_URL="http://localhost:5000"
JWT_EXPIRE=5d
JWT_SECRET=


APP_CLIENT_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback
# Deep link the Google callback redirects to for mobile sign-ins
# (?client=mobile). Must match the app scheme in apps/mobile/app.json.
# Leave empty to use the default habitflow://google-auth.
MOBILE_GOOGLE_REDIRECT=

# ── Mail (password reset) ───────────────────────────────────────────────
# Three transports, in the order MailService prefers them:
#
#   1. RESEND_API_KEY — HTTPS provider, and the only one that works on a
#      Render free instance (Render blocks outbound SMTP ports 25/465/587
#      there). Its shared onboarding@resend.dev sender is 403'd for every
#      recipient except the Resend account's own address, so production
#      needs a domain verified at resend.com/domains plus MAIL_FROM
#      (e.g. "HabitFlow <no-reply@example.com>") on that domain.
#   2. SMTP_MAIL + SMTP_PASSWORD — reaches any recipient without owning a
#      domain, and is fine for local dev. For Gmail the
#      password is an App Password (Google Account → Security → 2-Step
#      Verification → App passwords), never the login password, and daily
#      sending is capped. SMTP_SERVICE is a nodemailer service name and
#      defaults to gmail. This transport always sends as SMTP_MAIL —
#      consumer providers refuse to send as anyone else.
#   3. Neither configured — the mail is logged to stdout, reset link
#      included, which is enough to develop the whole flow.
RESEND_API_KEY=
MAIL_FROM=
SMTP_MAIL=
SMTP_PASSWORD=
SMTP_SERVICE=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

STRIPE_API_KEY=
STRIPE_SECRET_KEY=

# Keep-alive self-ping (prevents Render free tier from sleeping).
# On Render this works automatically via RENDER_EXTERNAL_URL — no config needed.
# KEEP_ALIVE_URL overrides the base URL on other hosts; leave empty in dev.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=
