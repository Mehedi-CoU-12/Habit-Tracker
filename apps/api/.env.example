PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/habitflow?schema=public"

# Redis cache (optional). Leave empty to run without caching — every read
# then goes straight to Postgres. Local: redis://localhost:6379. Hosted
# (Render Key Value, Upstash, ...): use the rediss:// URL they give you.
# A Redis outage never breaks the API; /health reports the connection state.
REDIS_URL=
FRONTEND_URL="http://localhost:5000"
JWT_EXPIRE=5d
JWT_SECRET=


APP_CLIENT_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback
# Deep link the Google callback redirects to for mobile sign-ins
# (?client=mobile). Must match the app scheme in apps/mobile/app.json.
# Leave empty to use the default habitflow://google-auth.
MOBILE_GOOGLE_REDIRECT=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

SMTP_MAIL=
SMTP_PASSWORD=
SMTP_SERVICE=
STRIPE_API_KEY=
STRIPE_SECRET_KEY=

# Keep-alive self-ping (prevents Render free tier from sleeping).
# On Render this works automatically via RENDER_EXTERNAL_URL — no config needed.
# KEEP_ALIVE_URL overrides the base URL on other hosts; leave empty in dev.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=
